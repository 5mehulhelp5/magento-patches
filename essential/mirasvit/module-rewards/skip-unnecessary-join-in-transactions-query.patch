     protected function _initSelect()
     {
         parent::_initSelect();
-        $this->initFields();
+        // BEGIN PATCH
+        // $this->initFields();
+        // END PATCH
     }

     /**
@@ -174,6 +176,13 @@ class Collection extends \Magento\Framework\Model\ResourceModel\Db\Collection\Ab
      */
     public function joinCustomerName()
     {
+        // BEGIN PATCH
+        // The customer join is no longer added in _initSelect(), so the legacy grid used to build
+        // the CSV/XML export (which also calls joinCustomerGroup(), joining ON customer.group_id)
+        // opts into it here. Only caller: RewardsAdminUi\Block\Adminhtml\Transaction\Grid.
+        $this->initFields();
+        // END PATCH
+
         return $this;
     }

